<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Nainazi</vendor>
  <vendor_url>https://github.com/Nainazi/keepassxc</vendor_url>
  <icon_name>@APP_ICON_NAME@</icon_name>
  
  <action id="com.nainazi.passbook.unlockDatabase">
    <description>Quick Unlock for a 奈娜子密码本 Database</description>
    <message>Authentication is required to unlock a 奈娜子密码本 database</message>
    <defaults>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
